<Project>
  <ItemGroup>
    <PackageVersion Remove="Microsoft.Extensions.DependencyInjection;Spectre.Console;Spectre.Console.Analyzer;Spectre.Console.Cli;Spectre.Console.Cli.Testing;Spectre.Console.Testing" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
