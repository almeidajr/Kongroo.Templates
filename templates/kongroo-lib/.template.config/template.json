{
  "$schema": "http://json.schemastore.org/template",
  "author": "José Rogério de Almeida Júnior <almeidajr.vr@gmail.com>",
  "classifications": ["Kongroo", "Library", "NuGet"],
  "identity": "Kongroo.Templates.Library",
  "name": "Kongroo Class Library",
  "shortName": "kongroo-lib",
  "tags": { "language": "C#", "type": "project" },
  "sourceName": "Kongroo.SampleApp.Library",
  "preferNameDirectory": true,
  "symbols": {
    "packable": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Make the library publishable to nuget.org (packaging metadata, MinVer, SourceLink, public-API analyzers)."
    }
  },
  "primaryOutputs": [{ "path": "Kongroo.SampleApp.Library.csproj" }],
  "sources": [
    {
      "exclude": ["**/bin/**", "**/obj/**", ".template.config/**"],
      "modifiers": [
        {
          "condition": "(!packable)",
          "exclude": ["README.md", "PublicAPI.Shipped.txt", "PublicAPI.Unshipped.txt", "Packages.props"]
        }
      ]
    }
  ],
  "postActions": [
    {
      "id": "restore",
      "condition": "true",
      "description": "Restore NuGet packages",
      "manualInstructions": [{ "text": "Run 'dotnet restore'" }],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    },
    {
      "id": "add-to-solution",
      "description": "Add the project to the solution",
      "manualInstructions": [{ "text": "Add to the solution: dotnet sln add ." }],
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "continueOnError": true
    }
  ]
}
