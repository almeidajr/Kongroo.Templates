{
  "$schema": "http://json.schemastore.org/template",
  "author": "José Rogério de Almeida Júnior <almeidajr.vr@gmail.com>",
  "classifications": ["Kongroo", "Solution"],
  "identity": "Kongroo.Templates.Solution",
  "name": "Kongroo Solution",
  "shortName": "kongroo-sln",
  "tags": { "language": "C#", "type": "solution" },
  "sourceName": "Kongroo.SampleApp",
  "preferNameDirectory": true,
  "sources": [
    {
      "exclude": [
        "**/bin/**",
        "**/obj/**",
        "**/node_modules/**",
        "**/.vs/**",
        "**/TestResults/**",
        "**/*.user",
        "**/artifacts/**",
        ".template.config/**"
      ]
    }
  ],
  "primaryOutputs": [{ "path": "Kongroo.SampleApp.slnx" }],
  "postActions": [
    {
      "id": "restore",
      "condition": "true",
      "description": "Restore NuGet packages",
      "manualInstructions": [{ "text": "Run 'dotnet restore'" }],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
